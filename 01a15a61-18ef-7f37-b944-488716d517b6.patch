-function Get-NormalizedPath {
-  param([string]$Value)
-  $full = [System.IO.Path]::GetFullPath($Value)
-  $root = [System.IO.Path]::GetPathRoot($full)
-  if ($full.Length -le $root.Length) { return $root }
