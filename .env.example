APP_NAME=DocuChat
APP_DESCRIPTION=Chat with your own documents
APP_VERSION=0.1.0

# PostgreSQL
POSTGRES_DB=docuchat
POSTGRES_USER=docuchat
POSTGRES_PASSWORD=docuchat
DATABASE_URL=postgresql+psycopg2://docuchat:docuchat@localhost:5433/docuchat

# Qdrant vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# Generation provider (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Embedding model (local, no paid API)
# intfloat/multilingual-e5-small, 384 dimensions,
# passage:/query: prefixes - do not change without
# approval.

# File storage and upload limits
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.txt,.pdf

# Anonymous sessions and cookies
SESSION_COOKIE_NAME=docuchat_session
SESSION_LIFETIME_DAYS=30
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# CORS (comma-separated explicit origins; required
# when credentials are used)
CORS_ORIGINS=http://localhost,http://localhost:8000

# Langfuse observability (optional; disabled by
# default). Full document text is never transmitted.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
